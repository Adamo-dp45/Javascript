<div class="card">
    <div class="card-body">
        <div class="card-title"><%= post.title %></div>
        <p class="card-text">
            <%= post.content.split('\n\n')[0].substring(0, 150) %>...
        </p>
        <a href="/article/<%= post.id %>" class="btn btn-primary">Lire la suite</a>
    </div>
</div>