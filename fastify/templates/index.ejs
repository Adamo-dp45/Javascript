<%- include('./shared/header.ejs', {title: 'Bienvenue sur mon blog'}) %>
<div class="container">

    <form action="" method="post">
        <div class="form-group mb-2">
            <label for="title">Titre</label>
            <input type="text" class="form-control" name="title" id="title">
        </div>
        <div class="form-group mb-2">
            <label for="content">Contenu</label>
            <textarea name="content" class="form-control" id="content"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Ajouter l'article</button>
    </form>

    <% if(locals.user) { %>
        <p></p>
    <% } %>

    <h1 class="display-6 my-4">Bienvenue sur mon blog</h1>
    <p>
        Bonjour les gens
    </p>
    <% if(locals.title) { %> <!-- Condition et 'locals' contient toutes les variables locales -->
        <p><%= title %></p>
    <% } %>

    <p><%- title %></p> <!-- '-' quand on veut afficher le html au lieu de l'échapper -->

    <div class="row row-cols-2">
        <% for(const post of postsdb) { %>
            <div class="col mb-2">
                <%- include('./shared/post.ejs', {post}) %>
            </div>
        <% } %>
    </div>
</div>
<%- include('./shared/footer.ejs') %>